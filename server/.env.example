# Copy this file to server\.env, which Git ignores, and change the values there.
# server-run.cmd reads it. Never put real passwords or keys in this example.

# demo, or production when production sign-in and storage exist.
HIVE_MODE=demo

# 0.0.0.0 accepts phones on the same network.
HIVE_HOST=0.0.0.0
HIVE_PORT=8080

# For production. The server does not read these two yet.
# DATABASE_URL=postgresql://user:password@host:5432/postgres
# SUPABASE_URL=https://your-project.supabase.co
