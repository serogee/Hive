# Copy this file to server\.env, which Git ignores, and change the values there.
# .\run server run reads it. Never put real passwords or keys in this example.

# demo, or production when production sign-in and storage exist.
HIVE_MODE=demo

# 0.0.0.0 accepts phones on the same network.
HIVE_HOST=0.0.0.0
HIVE_PORT=8080

# For production: the Supabase project that signs users in. Without it, the server starts, but nobody can sign in.
# SUPABASE_URL=https://your-project.supabase.co

# For production: where rooms are kept. Use the session pooler of the Supabase project. Without it, rooms are
# kept in memory and end when the server stops. Write special characters in the password as %-codes.
# Add ?sslmode=disable only for a database on a private network.
# DATABASE_URL=postgresql://user:password@host:5432/postgres

# Deletes accounts with the Supabase Admin API: Project Settings > API Keys > Secret keys. Keep it secret.
# Without it, the server refuses to delete accounts.
# SUPABASE_SECRET_KEY=
