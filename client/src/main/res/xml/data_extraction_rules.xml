<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later. The excluded file holds the sign-in and the credentials for rooms. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="file"
            path="datastore/hive.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="file"
            path="datastore/hive.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
