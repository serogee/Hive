<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later. The excluded files hold the sign-in, the credentials for rooms, and a download on this phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="file"
            path="datastore/hive.preferences_pb" />
        <exclude
            domain="sharedpref"
            path="apk_download.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="file"
            path="datastore/hive.preferences_pb" />
        <exclude
            domain="sharedpref"
            path="apk_download.xml" />
    </device-transfer>
</data-extraction-rules>
