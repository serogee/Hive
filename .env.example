# Copy this file to .env, which Git ignores, for .\run server docker and docker compose.
# The password protects the local database only. Never use a real password here.
HIVE_DB_PASSWORD=hive-local-only

# The port that phones and the app use on this computer.
HIVE_PORT=8080

# The Supabase project that signs users in. Leave it empty to run without sign-in.
SUPABASE_URL=

# The Supabase secret key, which deletes accounts. Leave it empty unless you test account deletion.
SUPABASE_SECRET_KEY=
